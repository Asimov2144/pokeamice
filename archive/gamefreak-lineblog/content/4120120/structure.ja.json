      "images": []
    },
    {
      "type": "p",
      "alignment": "left",
      "markdown": "<div class=\"gf-lineblog-line gf-lineblog-line--left\">Treehouse: Live at E3 will be streamed via <a class=\"gf-lineblog-source-link\" href=\"http://www.youtube.com/nintendo\" target=\"_blank\" rel=\"noopener\">YouTube</a>\n, <a class=\"gf-lineblog-source-link\" href=\"http://twitch.tv/nintendo\" target=\"_blank\" rel=\"noopener\">Twitch</a>\n, and\n <a class=\"gf-lineblog-source-link\" href=\"http://e3.nintendo.com/\" target=\"_blank\" rel=\"noopener\">Nintendo’s E3 website</a>.\n<br></div>",
      "images": []
