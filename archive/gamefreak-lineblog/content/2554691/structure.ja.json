      "markdown": "{% lineblog_image id=\"line-2554691-002\" alt=\"\" %}\n\n\n<br>\n\n\nこらこら！\n\n\n{% lineblog_image id=\"line-2554691-003\" alt=\"\" %}\n\n\n<br>\n\n\n海苔に\nキキも興味津々！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n3つの海苔と・・\n海苔に合うという\nこちら！\n\n\n{% lineblog_image id=\"line-2554691-004\" alt=\"\" %}\n\n\n\n<br>\n\n\nこれに\nマヨネーズを合わせて\n海苔を食べるとウマい！って\n書いてあった（笑）\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\nあと\nものすごく感動した\n八丈島のヨーグルトドリンク！\n\n<br>\n\n\n\n\n{% lineblog_image id=\"line-2554691-005\" alt=\"\" %}\n\n\n<br>\n\n\nさらっと美味しく\n甘くて最高！！\n\n<br>\n\n\n\n                八丈島に行ったら\n必ず飲んで欲しい！\n絶品です！！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\nそして\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\nどーしても\n作りたいと思ったのが\nあしたばビール！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n粉末が空港にあったので\n買ってみた（笑）\n\n\n{% lineblog_image id=\"line-2554691-006\" alt=\"\" %}\n\n\n<br>\n\n\nさっそく\n作ってみたよ！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\nあしたば粉末 vs スーパードライ！\n\n<br>\n\n\n\n\n{% lineblog_image id=\"line-2554691-007\" alt=\"\" %}\n\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n\n                    まずは\n                \n粉を入れて・・・\n\n\n{% lineblog_image id=\"line-2554691-008\" alt=\"\" %}\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\nビールを注ぐ！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n\n\n\n\n<br>\n\n\nええ？！\n\n<br>\n\n\nあれ？？？！！！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\nビールを注ぐ！\n\n\n\n{% lineblog_image id=\"line-2554691-010\" alt=\"\" %}\n\n\n<br>\n\n\n\n<br>\n\n\nぐわー！！\nこれなんだ？！！\n\n<br>\n\n\nすでに\n恐ろしげな飲み物に・・・\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\nまあ\nあれか\n\n<br>\n\n\n見た目と味は違うという\nあれか\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n思い切って\n飲んでみる！\n\n\n{% lineblog_image id=\"line-2554691-011\" alt=\"\" %}\n\n\n<br>\n\n\nん？？\n\n\n{% lineblog_image id=\"line-2554691-012\" alt=\"\" %}\n\n\n<br>\n\n\n\n<br>\n\n\nんっんんんっ？？？\n\n<br>\n\n\n\n\n{% lineblog_image id=\"line-2554691-013\" alt=\"\" %}\n\n\n<br>\n\n\nうわっっ！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\nやっぱり\nまずいっ！！！！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n完全に\nあしたばと\nビールが分離した味！！\n\n<br>\n\n\nこれ\n完全に罰ゲームじゃん（笑）\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n（次回予告）\n\n<br>\n\n\nあしたば粉末 vs プレミアムモルツ！\nお楽しみに！（笑）\n\n<br>",
