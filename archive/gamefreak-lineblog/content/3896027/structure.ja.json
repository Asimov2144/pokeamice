    {
      "type": "div",
      "alignment": "center",
      "markdown": "<div class=\"gf-lineblog-line gf-lineblog-line--center\">{% lineblog_image id=\"line-3896027-002\" alt=\"\" %}\n\n\n\n\n\n\n{% lineblog_image id=\"line-3896027-003\" alt=\"\" %}\n\n\n<br>\n\n\n\nさすがメガトウキョー！\n\n\n{% lineblog_image id=\"line-3896027-004\" alt=\"\" %}\n\n約1000人近くの方が来てくださった！\nまさにメガ級！\nみんな来てくれてありがとう！\n\n<br>\n\n\n\n<br>\n\n\n<br>\n\n\n\n            3月19日（土）\nポケモンセンターヒロシマ！\n<br>\n\n\n\n\n{% lineblog_image id=\"line-3896027-005\" alt=\"\" %}\n\n\n\n            初めての広島！\n平和記念公園も感動しました！\n\n\n{% lineblog_image id=\"line-3896027-006\" alt=\"\" %}\n\n長蛇の列！\n広島のみんな！\nありがとう！</div>",
