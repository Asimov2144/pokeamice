      "markdown": "{% lineblog_image id=\"line-2540602-002\" alt=\"\" %}\n\n\n<br>\n\n\n看板で共通の・・・\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n遊具広場！！\n\n<br>\n\n\nじゃないよ（笑）\nキョンだよ！！\nキョン！！！\n\n<br>\n\n\n\n<br>\n\n\nついに会えた！\n\n<br>\n\n\n\n\n{% lineblog_image id=\"line-2540602-003\" alt=\"\" %}\n\n\n<br>\n\n\nちっちゃ！\n子供のキョン？！\n\n<br>\n\n\n\n\n{% lineblog_image id=\"line-2540602-004\" alt=\"\" %}\n\n\n<br>\n\n\nあれ？\nみんな小さい！！\n\n<br>\n\n\nキョンって\n小さかったんだ！\n\n<br>\n\n\n鹿ぐらいと\n勝手にイメージしてた（笑）\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n八丈島のキョン！\nやっと会えたね！！\n\n<br>\n\n\n\n\n\n{% lineblog_image id=\"line-2540602-005\" alt=\"\" %}\n\n\n\n\n<br>\n\n\nかわいい・・・\n\n<br>\n\n\n\n<br>\n\n\n子供の頃\nがきデカ という漫画で知った\n八丈島のキョン\n\n<br>\n\n\nついに会えました！！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n東京から\nピカチュウを作りに来てくれた\nポケモンファンと一緒に\n記念撮影！\n\n<br>\n\n\n\n\n{% lineblog_image id=\"line-2540602-006\" alt=\"\" %}\n\n\n\n<br>\n\n\nみんな\nありがとう！！\n一緒にキョン見れたのは\n一生の思い出だよ！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\nそしてこの時\nメールが届きました。\n\n<br>\n\n\n明日 羽田に戻る朝1便が\n欠航の可能性大！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\nええ？！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\nすぐに帰る便しかないことが判明\n宿を1日キャンセルして\n急いで空港へ！\n\n<br>\n\n\n\n<br>\n\n\nフリージアまつりの\nクローズイベントに\n参加できず残念！！\n\n<br>\n\n\n\n<br>\n\n\nひとり空港へ\n\n<br>\n\n\n\n\n{% lineblog_image id=\"line-2540602-007\" alt=\"\" %}\n\n\n<br>\n\n\n\n            飛行機遅れて\nなかなか離陸しなかったけど・・・\n\n<br>\n\n\n\n<br>\n\n\n機内から外を見ると\nなんと\n手を振る人たちを発見！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n一緒にキョンを見た\nみんなが\n手を振って見送ってくれてました！\n\n<br>\n\n\n\n\n{% lineblog_image id=\"line-2540602-008\" alt=\"\" %}\n\n\n<br>\n\n\n写真だと分からないか（笑）\n\n<br>\n\n\n\n<br>\n\n\n見送ってくれた側の写真がこちら\n\n\n{% lineblog_image id=\"line-2540602-009\" alt=\"\" %}\n\n\n（マスダが乗ってるANA）\n\n<br>\n\n\nみんな ありがとうね！！\nまた会いましょう！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n今回の\nインフィオラータ\n\n<br>\n\n\n思い出いっぱい\n素敵で\n幸せな\n時間になりました！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n八丈島のみなさん！\n\nまた遊びに来ます！！\n\nありがとうございました！！\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n（オマケ）\nキョンをもっと知りたい方は\nこちらをどうぞ！\n\n\n{% lineblog_image id=\"line-2540602-010\" alt=\"\" %}\n\n\n\n<br>",
