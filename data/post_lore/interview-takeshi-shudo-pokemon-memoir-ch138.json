 "observations": [
  {
   "seg": 1,
   "text": "首藤刚志称接到汤山邦彦电话时，正过着无业游民生活约两周。",
   "anchor": 2
  },
  {
   "seg": 2,
   "text": "汤山邦彦电话中说很快会有很棒的工作找上门，两天后制片人来电。",
   "anchor": 3
  }
 ],
