 "observations": [
  {
   "seg": 2,
   "text": "1983年读高中时自制油印小报《Game Freak》，在复印机前印、订书机装订、秋叶原小店代销",
   "anchor": 3
  },
  {
   "seg": 4,
   "text": "买不起任天堂数十万日元的开发机，拆红白机逆向分析，在秋叶原淘二手IC与EPROM烧录器，手工焊出开发机",
   "anchor": 5
  }
 ],
