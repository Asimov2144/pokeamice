 "observations": [
  {
   "seg": 1,
   "text": "首藤刚志说《洛奇亚爆诞》真正想做的是刻画各人物处境与视线，让万物共存浮现。",
   "anchor": 2
  },
  {
   "seg": 4,
   "text": "首藤刚志就任系列构成总编剧前，早期企划会议已敲定创造贯穿全剧的常驻反派。",
   "anchor": 5
  }
 ],
