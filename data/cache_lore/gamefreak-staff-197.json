{"key": "2e3d9b07635bce67", "answer": {"observations": [{"seg": 4, "text": "妮洛莉卡独自去法国旅行，努力和当地人聊天。"}, {"seg": 13, "text": "乔尼在婚礼前拍了婚纱照，按摄影师指示摆姿势。"}, {"seg": 18, "text": "小星去了澳门的赌场，赌场就在酒店里面。"}, {"seg": 24, "text": "纳吉周二周三住热海玩桌游，周四周五周六去青森。"}, {"seg": 32, "text": "佐藤和老家的家人爬附近的山看瀑布。"}, {"seg": 37, "text": "卡拉希去了水木茂大道，因《鬼太郎之妻》人气而人多。"}, {"seg": 47, "text": "埃尔卡茨蜜月10天逛了意大利、法国、德国3个国家。"}, {"seg": 57, "text": "一池一直在玩“天下统一”，推荐玩家使用忍者。"}, {"seg": 64, "text": "和本为看高中棒球比赛，和大学朋友去了甲子园。"}, {"seg": 68, "text": "和本回老家住亲戚家，看宝冢的DVD流下眼泪。"}], "pokemon": [], "places": [{"name": "法国", "seg": 4, "what": "独自旅行地", "world": "real"}, {"name": "澳门", "seg": 18, "what": "赌场所在", "world": "real"}, {"name": "热海", "seg": 24, "what": "桌游旅行地", "world": "real"}, {"name": "青森", "seg": 25, "what": "看白神山地十和田湖", "world": "real"}, {"name": "白神山地", "seg": 25, "what": "青森观光地", "world": "real"}, {"name": "十和田湖", "seg": 25, "what": "青森观光地", "world": "real"}, {"name": "水木茂大道", "seg": 37, "what": "妖怪雕像街道", "world": "real"}, {"name": "甲子园", "seg": 64, "what": "高中棒球观赛地", "world": "real"}], "works": [{"name": "鬼太郎之妻", "seg": 38}, {"name": "天下统一", "seg": 57}, {"name": "宝冢DVD", "seg": 68}], "people": [{"name": "にょろリカ（妮洛莉卡）", "seg": 0}, {"name": "カニ子（蟹子）", "seg": 7}, {"name": "ジョニー（乔尼）", "seg": 16}, {"name": "ほっしー（小星）", "seg": 21}, {"name": "なぎー（纳吉）", "seg": 30}, {"name": "さとう（佐藤）", "seg": 35}, {"name": "カラシ（卡拉希）", "seg": 43}, {"name": "えるかつ（埃尔卡茨）", "seg": 46}, {"name": "一池", "seg": 62}, {"name": "わも（和本）", "seg": 70}]}}