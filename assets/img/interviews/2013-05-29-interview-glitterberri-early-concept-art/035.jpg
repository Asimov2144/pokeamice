              if (oldonload) {
                oldonload()
              }
              func()
            }
          }
        }

        /**
         * detecting browser version https://stackoverflow.com/a/38080051
         * @type {{name, version}}
         */
        navigator.browserSpecs = (function () {
          var ua = navigator.userAgent,
            tem,
            isMobile = false,
            M = ua.match(/(opera|chrome|safari|firefox|msie|trident(?=\/))\/?\s*(\d+)/i) || []

          if ((tem = ua.match(/Android|Mobile/i)) != null) {
            isMobile = true
          }

          if (/trident/i.test(M[1])) {
            tem = /\brv[ :]+(\d+)/g.exec(ua) || []
            return {
              name: 'IE',
              version: tem[1] || '',
              isMobile: isMobile,
            }
          }

          if (M[1] === 'Chrome') {
            const operaMatch = ua.match(/\b(OPR|Edge)\/(\d+)/)
            const duckMatch = ua.match(/DuckDuckGo\/(\d+)/i)
            const ucMatch = ua.match(/UCBrowser\/(\d+)/i)
            const facebookMatch = ua.match(/FBAV\/(\d+)/i)

            if (operaMatch != null) {
              return {
                name: operaMatch[1].replace('OPR', 'Opera'),
                version: operaMatch[2],
                isMobile: isMobile,
              }
            }

            if (duckMatch != null) {
              return {
                name: duckMatch[0].split('/')[0],
                version: duckMatch[1],
                isMobile: isMobile,
              }
            }

            if (ucMatch != null) {
              return {
                name: ucMatch[0].split('/')[0],
                version: ucMatch[1].split('.')[0],
                isMobile: isMobile,
              }
            }

            if (facebookMatch != null) {
              return {
                name: facebookMatch[0].split('/')[0],
                version: facebookMatch[1].split('.')[0],
                isMobile: isMobile,
              }
            }

            if (isMobile && tem[0] === 'Android') {
              return {
                name: M[1],
                version: M[2],
                isMobile: isMobile,
              }
            }
          }

          M = M[2] ? [M[1], M[2]] : [navigator.appName, navigator.appVersion, '-?']
          if ((tem = ua.match(/version\/(\d+)/i)) != null) {
            M.splice(1, 1, tem[1])
          }

          return {
            name: M[0],
            version: M[1],
            isMobile: isMobile,
          }
        })()

        var isOldBrowser = false
