            if (outdatedContainer) {
              outdatedContainer.innerHTML =
                "<div id='head-message'><!--<h6>Your browser is out-of-date!</h6>--><img src='/img/photobucket-dark.png' alt='logo' class='logo'><p>DON'T PANIC, YOUR PHOTOS ARE SAFE!<br>Your browser is out of date.To maximize your privacy and for a better overall experience, please update it by clicking on an option below.<a id='btnUpdateBrowser' href='javascript://'></a><a id='btnCloseUpdateBrowser' href='javascript://'></a></p></div><div id='content' class='home' role='main'><div id='preload' aria-hidden='true'><img src='/outdatedbrowser/img/browsers-bg.png' alt=''><img src='/outdatedbrowser/img/operatingsystems-bg.png' alt=''></div><div class='inner'><!-- SECTION --><!-- DATA SOURCE:Browser Version: http://caniuse.com/usage_table.phpBrowser Statistics: http://gs.statcounter.com/--><section class='c_browsers sorted kwicks kwicks-horizontal hideBrowsers'><!-- BROWSER - Chrome --><div id='chrome' class='browser'><h3 class='statistic'>minimal supported version:<br><span>43</span></h3><div class='center'><h2><span></span> GOOGLE CHROME</h2><div class='download' id='chrome'><a href='https://web.archive.org/web/20210813162629/https://www.google.com/chrome/browser/desktop/' target='_blank' class='browserlink' data-track='Google Chrome'>DOWNLOAD</a><h4>VERSION <span>68</span></h4></div></div><div class='available'><h4>AVAILABLE FOR </h4><ul><li class='windows'><span>Windows</span></li><li class='mac'><span>Mac OS</span></li><li class='linux'><span>Linux</span></li></ul></div></div><!-- BROWSER - Firefox --><div id='firefox' class='browser'><h3 class='statistic'>minimal supported version:<br><span>52</span></h3><div class='center'><h2><span></span> MOZILLA FIREFOX</h2><div class='download' id='firefox'><a href='https://web.archive.org/web/20210813162629/http://www.mozilla.org/firefox/new/' target='_blank' class='browserlink' data-track='Mozilla Firefox'>DOWNLOAD</a><h4>VERSION <span>61</span></h4></div></div><div class='available'><h4>AVAILABLE FOR </h4><ul><li class='windows'><span>Windows</span></li><li class='mac'><span>Mac OS</span></li><li class='linux'><span>Linux</span></li></ul></div></div><!-- BROWSER - Internet Explorer --><div id='internetExplorer' class='browser'><h3 class='statistic'>minimal supported version:<br><span>14</span></h3><div class='center'><h2 class='edge'><span></span> MICROSOFT EDGE </h2><div class='download' id='edge'><a href='https://web.archive.org/web/20210813162629/https://www.microsoft.com/software-download/windows10' target='_blank' class='browserlink edge-btn'data-track='Internet Explorer'>DOWNLOAD</a><h4>VERSION <span>18</span></h4><!--<h5>Available only with Windows 10</h5>--></div></div><div class='available'><h4>AVAILABLE FOR </h4><ul class='single'><li class='windows'><span>Windows</span></li></ul></div></div><!-- BROWSER - Safari --><div id='safari' class='browser'><h3 class='statistic'>minimal supported version:<br><span>10</span></h3><div class='center'><h2><span></span> APPLE SAFARI</h2><div class='download' id='safari'><a href='https://web.archive.org/web/20210813162629/http://www.apple.com/osx/' target='_blank' class='browserlink macos-btn' data-track='Apple Safari'>DOWNLOAD</a><h4>VERSION <span>11</span></h4><!--<h5>Available only with macOS</h5>--></div></div><div class='available'><h4>AVAILABLE FOR </h4><ul class='single'><li class='mac'><span>Mac OS</span></li></ul></div></div><!-- BROWSER - Opera --><div id='opera' class='browser'><h3 class='statistic'>minimal supported version:<br><span>37</span></h3><div class='center'><h2><span></span> OPERA</h2><div class='download' id='opera'><a href='https://web.archive.org/web/20210813162629/http://www.opera.com/?utm_medium=roc&utm_source=burocratik&utm_campaign=outdatedbrowser' target='_blank'data-track='Opera' class='browserlink'>DOWNLOAD</a><h4>VERSION <span>54</span></h4></div></div><div class='available'><h4>AVAILABLE FOR </h4><ul><li class='windows'><span>Windows</span></li><li class='mac'><span>Mac OS</span></li><li class='linux'><span