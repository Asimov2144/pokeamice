1a7f.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/3205071/001-af4db91a7f.webp\" alt=\"\" loading=\"lazy\" width=\"1136\" height=\"1136\"></a></figure>\n\n\n<br></div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\">先从美国开始……</div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\">梯子型和直线型！</div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\"><br></div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\"><br></div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\"><figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/3205071/002-1484948c46.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/3205071/002-1484948c46.webp\" alt=\"\" loading=\"lazy\" width=\"567\" height=\"601\"></a></figure>\n\n\n<br></div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\">不知为什么……</div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\">西雅图是</div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\">两条线！</div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\"><br></div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\"><br></div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\"><br></div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\">加拿大</div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\">温哥华！</div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\"><br></div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\"><figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/3205071/003-487ca2c277.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/3205071/003-487ca2c277.webp\" alt=\"\" loading=\"lazy\" width=\"621\" height=\"840\"></a></figure>\n\n直线型和\n自行车道！\n\n<br>\n\n\n自行车很多嘛……不愧是温哥华！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n法国！\n\n<br>\n\n\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/3205071/004-6db900eb5c.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/3205071/004-6db900eb5c.webp\" alt=\"\" loading=\"lazy\" width=\"1136\" height=\"1136\"></a></figure>\n\n\n<br>\n\n\n基本上都是横纹型！\n\n<br>\n\n\n\n<br>\n\n\n但是……\n\n<br>\n\n\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/3205071/005-a15f7cd343.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/3205071/005-a15f7cd343.webp\" alt=\"\" loading=\"lazy\" width=\"320\" height=\"427\"></a></figure>\n\n\n<br>\n\n\n\n\n            有些地方\n在石板路上\n画着横纹……太厉害了！\n\n\n<br>\n\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n德国和西班牙！\n\n<br>\n\n\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/3205071/006-554c01834e.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/3205071/006-554c01834e.webp\" alt=\"\" loading=\"lazy\" width=\"621\" height=\"840\"></a></figure>\n\n\n<br>\n\n\n两边都是虚线型！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n            然后是\n汽车很多的\n英国伦敦！\n\n<br>\n\n\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/3205071/007-7dad768fb7.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/3205071/007-7dad768fb7.webp\" alt=\"\" loading=\"lazy\" width=\"621\" height=\"840\"></a></figure>\n\n\n<br>\n\n\n虚线型和文字标识！！\n\n<br>\n\n\n总觉得很不可思议……\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n然后是\n日本\n\n<br>\n\n\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/3205071/008-9aa94d1875.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/3205071/008-9aa94d1875.webp\" alt=\"\" loading=\"lazy\" width=\"621\" height=\"840\"></a></figure>\n\n\n<br>\n\n\n简洁的横纹！\n\n<br>\n\n\n\n<br>\n\n\n我记得以前是梯子型的，\n难道这是最近的主流？\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n日本的横纹要说起来……\n还有这处在全世界都很有名的！\n\n<br>\n\n\n\n\n<figure 