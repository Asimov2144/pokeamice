04-a890cefffb.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/2880077/004-a890cefffb.webp\" alt=\"\" loading=\"lazy\" width=\"639\" height=\"852\"></a></figure>\n\n\n<br>\n\n\n\n<br>\n\n\nマスダが手にしている\nゲームフリークの\nカードキー\n\n<br>\n\n\nここには\n\n<br>\n\n\n「いいものつくろう！」\n\n<br>\n\n\nと書いています\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n            落ち込んだとき\n難題にぶつかったとき\n迷ったとき\n\n<br>\n\n\n\n<br>\n\n\nどんな時でも\nこのカードキーを見て\nいいものつくろう！\nと気持ちが高まるように・・\n\n<br>\n\n\nそんな願いが\n込められています\n\n<br></div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\"><br></div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\"><br></div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\">日常</div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\"><br></div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\"><br></div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\"><br></div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\">昨日までのサイン会では</div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\">みんなとワイワイして</div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\">とっても楽しかったし</div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\"><br></div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\">会社に行く普通の日常も</div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\">楽しいのです！</div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\"><br></div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\"><br></div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\"><br></div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\">チャオ！</div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\"><br></div>"}}