65dc2d81.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/4220652/002-7665dc2d81.webp\" alt=\"\" loading=\"lazy\" width=\"637\" height=\"502\"></a></figure>\n\n会场的L.A.会议中心！\n\n<br>\n\n\n\n<br>\n\n\n\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/4220652/003-f917d387db.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/4220652/003-f917d387db.webp\" alt=\"\" loading=\"lazy\" width=\"1136\" height=\"852\"></a></figure>\n\n在Treehouse Live中多次承蒙关照的\n任天堂展台！\n\n<br>\n\n\n\n<br>\n\n\n它的前面是\nGran Turismo！\n\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/4220652/004-5ecac8ceea.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/4220652/004-5ecac8ceea.webp\" alt=\"\" loading=\"lazy\" width=\"1136\" height=\"852\"></a></figure>\n\n这样比赛一定很开心！\n\n\n<br>\n\n\n\n<br>\n\n\n其他展台也逛了逛！\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/4220652/005-fe1a178f66.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/4220652/005-fe1a178f66.webp\" alt=\"\" loading=\"lazy\" width=\"1136\" height=\"1136\"></a></figure>\n\n到处都很拥挤！\n喜欢Eidos的设定！\n\n\n<br>\n\n\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/4220652/006-56ba58f2e2.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/4220652/006-56ba58f2e2.webp\" alt=\"\" loading=\"lazy\" width=\"1136\" height=\"1136\"></a></figure>\n\nReCore由\n在《宝可梦交响进化》中\n为我们编曲的\nChad负责作曲！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n还有这种！\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/4220652/007-0a9b37c6fb.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/4220652/007-0a9b37c6fb.webp\" alt=\"\" loading=\"lazy\" width=\"1136\" height=\"852\"></a></figure>\n\n看看这个手柄！！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\nVR？\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n不对！\n是普通画面（笑）\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/4220652/008-9618f563b3.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/4220652/008-9618f563b3.webp\" alt=\"\" loading=\"lazy\" width=\"1136\" height=\"852\"></a></figure>\n\n\n                            而且玩的是\n超级任天堂的\n马力欧卡丁车（笑）\n\n<br>\n\n\n\n<br>\n\n\n好开心（笑）\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n这次\n最棒的是\n这个！\n\n<br>\n\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/4220652/009-79a0ad137f.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/4220652/009-79a0ad137f.webp\" alt=\"\" loading=\"lazy\" width=\"1136\" height=\"852\"></a></figure>\n\n\n全景！\n\n<br>\n\n\n\n<br>\n\n\n嗯？\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/4220652/010-2b5ee53c4e.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/4220652/010-2b5ee53c4e.webp\" alt=\"\" loading=\"lazy\" width=\"639\" height=\"852\"></a></figure>\n\n\n                                好帅！！！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n模仿了一下敌人（笑）\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/4220652/011-b676a6eaf0.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/4220652/011-b676a6eaf0.webp\" alt=\"\" loading=\"lazy\" width=\"1136\" height=\"852\"></a></figure>\n\n\n<br>\n\n\n还有会动的蘑菇！\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/4220652/012-2780a093fc.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/4220652/012-2780a093fc.webp\" alt=\"\" loading=\"lazy\" width=\"639\" height=\"852\"></a></figure>\n\n\n<br>\n\n\n\n<br>\n\n\n然后！\n\n<br>\n\n\n\n<br>\n\n\n当然\n我也玩了！！\n\n\n\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/4220652/013-0d848c168f.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/4220652/013-0d848c168f.webp\" alt=\"\" loading=\"lazy\" width=\"1136\" height=\"852\"></a></figure>\n\n\n\n<br>\n\n\n风和草的表现太棒了！\n感觉把硬件性能发挥到了极限！\n\n<br>\n\n\n\n<br>\n\n\n气温、音量、\n武器的磨损、\n肚子会饿等等，\n这是和以往不同的\n全新感觉的\n《塞尔达传说》！\n                                <br>\n\n\n\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/4220652/014-8e41d3dcca.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/4220652/014-8e41d3dcca.webp\" alt=\"\" loading=\"lazy\" width=\"1136\" height=\"852\"></a></figure>\n\n\n                                        好开心！！\n\n<br>\n\n\n\n\n\n<br>\n\n\n下回再见！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n（附带）\n发现了宝可梦！\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/4220652/015-e45b1dec52.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/4220652/015-e45b1dec52.webp\" alt=\"\" loading=\"lazy\" width=\"1136\" height=\"852\"></a></figure>\n\n谢谢！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\n\n<br></div>","markdown_ja":"<div class=\"gf-lineblog-line gf-lineblog-line--center\"><br></div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\">今年のE3</div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\">いろいろ見ましたが</div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\">VRや新しい表現方法など</div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\">ゲーム業界に</div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\">新しい風が</div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\">吹き始めている感じがしました！</div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\"><br></div>\n<div class=\"gf-lineblog-line gf-lineblog-line--center\"><figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/4220652/002-7665dc2d81.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/4220652/002-7665dc2d81.webp\" alt=\"\" loading=\"lazy\" width=\"637\" height=\"502\"></a></figure>\n\n会場のL.A コンベンションセンター！\n\n<br>\n\n\n\n<br>\n\n\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/4220652/003-f917d387db.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/4220652/003-f917d387db.webp\" alt=\"\" loading=\"lazy\" width=\"1136\" height=\"852\"></a></figure>\n\nTreehouse Liveで何度もお世話になった\n任天堂さんのブース！\n\n<br>\n\n\n\n<br>\n\n\nその前には\nグランツーリスモ！\n\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/4220652/004-5ecac8ceea.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/4220652/004-5ecac8ceea.webp\" alt=\"\" loading=\"lazy\" width=\"1136\" height=\"852\"></a></figure>\n\nこれで競争するのは楽しそう！\n\n\n<br>\n\n\n\n<br>\n\n\n他のブースも周ったよ！\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/4220652/005-fe1a178f66.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/4220652/005-fe1a178f66.webp\" alt=\"\" loading=\"lazy\" width=\"1136\" height=\"1136\"></a></figure>\n\nどこも混んでました！\nEidosの設定好き！\n\n\n<br>\n\n\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/4220652/006-56ba58f2e2.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/4220652/006-56ba58f2e2.webp\" alt=\"\" loading=\"lazy\" width=\"1136\" height=\"1136\"></a></figure>\n\nReCoreは\nPokémon Symphonic Evolutions で\n編曲してくれている\nChadが作曲！\n\n<br>\n\n\n\n<br>\n\n\n\n<br>\n\n\nこんなのも！\n\n\n<figure class=\"gf-lineblog-image\"><a href=\"/assets/images/gamefreak-lineblog/4220652/007-0a9b37c6fb.webp\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-lineblog/4220652/007-0a9b37c6fb.webp\" alt=\"\" loading=\"lazy\" width=\"1136\" height=\