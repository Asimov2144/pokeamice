ll,"role":"mentioned","seg":[19]},{"name":"蟹子","slug":null,"role":"mentioned","seg":[]},{"name":"カビ","slug":null,"role":"mentioned","seg":[23,68]}],"places":[],"concepts":[{"id":"battle-system","name":"对战系统","facet":"system","seg":[8,14],"as":["宝可梦对战","打对战"],"via":"body"},{"id":"competitive","name":"竞技与官方大赛","facet":"system","seg":[10,13,21],"as":["对战大会"],"via":"body"},{"id":"studio-culture","name":"公司氛围","facet":"team","seg":[10,13,19,53,57,64],"as":["公司内部","社内"],"via":"body"},{"id":"link-battle","name":"通信对战","facet":"system","seg":[14],"as":["双打对战"],"via":"body"},{"id":"mentoring","name":"带人与培养","facet":"team","seg":[15],"as":["培养"],"via":"body"},{"id":"raising","name":"培育","facet":"system","seg":[60],"as":["育成"],"via":"body"}]},"observations":[{"seg":22,"text":"本次大会共有26名员工参加"},{"seg":24,"text":"参赛者分成两个联盟进行循环赛"}],"relations":[{"id":"gamefreak-staff-85","kind":"background","label":"为这篇提供背景","title":"【工作日志】2008年夏日卡牌大会","url":"/gamefreak-staff/entry-85/","why":"白金工作告一段落后重启社内对战活动"},{"id":"gamefreak-staff-87","kind":"background","label":"为这篇提供背景","title":"【工作日志】宝可梦白金版明日发售","url":"/gamefreak-staff/entry-87/","why":"白金发售前夜，本篇为发售纪念大会"},{"id":"gamefreak-director-131","kind":"background","label":"为这篇提供背景","title":"第131回","url":"/gamefreak-director/entry-131/","why":"白金9月13日发售，本篇为发售纪念大会"}],"sources":{"pokemon_names":"2026-09-23","tour_places":"2026-09-23","model":"deepseek-chat","relations_model":"deepseek-chat","concepts":"2026-09-26"},"built":"2026-09-25","edited":false,"by_seg":{"49":{"dex":[35,316]},"6":{"dex":[35,316]},"31":{"dex":[36]},"76":{"dex":[36]},"29":{"dex":[128]},"74":{"dex":[128]},"27":{"dex":[335]},"37":{"dex":[335]},"72":{"dex":[335]},"82":{"dex":[335]},"30":{"dex":[352]},"75":{"dex":[352]},"32":{"dex":[400]},"77":{"dex":[400]},"28":{"dex":[424]},"73":{"dex":[424]},"1":{"people":["いわし"]},"44":{"people":["いわし"]},"50":{"people":["いわし"]},"63":{"people":["いわし"]},"66":{"people":["いわし"]},"71":{"people":["いわし"]},"19":{"people":["森本"],"concepts":["studio-culture"]},"23":{"people":["カビ"]},"68":{"people":["カビ"]},"8":{"concepts":["battle-system"]},"14":{"concepts":["battle-system","link-battle"]},"10":{"concepts":["competitive","studio-culture"]},"13":{"concepts":["competitive","studio-culture"]},"21":{"concepts":["competitive"]},"53":{"concepts":["studio-culture"]},"57":{"concepts":["studio-culture"]},"64":{"concepts":["studio-culture"]},"15":{"concepts":["mentoring"]},"60":{"concepts":["raising"]},"22":{"obs":0},"24":{"obs":1}}},"archive_type":"gamefreak_legacy_blog","summary":"GAME FREAK员工记录宝可梦白金发售纪念对战大会，分享社内训练家激战、分组赛制与决胜淘汰赛前的现场实况。","interviewer":null,"translator":null,"original_lang":null,"translation_status":"openai-machine-translated","body":{"kind":"markdown","markdown_zh":"<div data-gf-language-panel=\"zh-CN\">\n你好。<br>\n\n我是策划人员いわし（沙丁鱼）。\n\n突然想问问大家，玩宝可梦时，什么时候最投入呢？<br>\n\n是收集图鉴的时候？<br>\n\n是参加华丽大赛的时候？<br>\n\n还是随着剧情发展的时候？<br>\n\n比如把盒子塞满皮皮和溶食兽？？<br>\n\n宝可梦有各种各样的玩法，不过我肯定选对战！\n\n宝可梦对战从明年开始将举办世界大会，现在各国也正在世界各地举行预选赛，<br>\n\n选出各国代表呢！\n\n其实，GAME FREAK公司内部也举办了宝可梦白金发售纪念对战大会！<br>\n\n之前的[カニ子（蟹子）的日记](http://www.gamefreak.co.jp/blog/staff/?p=95)里也提到过吧。\n\n<figure class=\"gf-legacy-image\"><a href=\"/assets/images/gamefreak-legacy/staff/99/iwa081201_01-daead84b.jpg\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-legacy/staff/99/iwa081201_01-daead84b.jpg\" alt=\"みんな対戦中\" loading=\"lazy\"></a></figure>\n\n过去每次推出新作时，GAME FREAK也都会在公司内部举办对战大会。<br>\n\n这次遵循世界大会的官方规则，采用双打对战！<br>\n\n这需要和单打风格迥异的宝可梦培养方式与战术呢～。\n\n↓世界大会及官方规则的相关信息请看这里↓<br>\n\n[http://www.pokemon.co.jp/special/wcs0809/](http://www.pokemon.co.jp/special/wcs0809/)\n\n对我来说，最值得关注的果然还是：面对那位曾让无数猛将挑战、<br>\n\n却都被打得落花流水的公司内部最强宝可梦训练家もりもと（森本），<br>\n\n这次会不会出现一位能让他尝到败绩的训练家吧～。<br>\n\n抱着“我反而要去给他点颜色看看！”的决心，这次我也参加了对战大会！\n\n本次大会共有26名员工参加，规模相当大。<br>\n\n员工博客里的熟面孔カニ子和カビ（卡比）等人也参加了哦！<br>\n\n由于参赛人数较多，大家被分成两个联盟进行循环赛，<br>\n\n按胜场数排名，前3名晋级决胜淘汰赛。\n\n顺便说一下，我的成员配置是……\n\n猫鼬斩<br>\n\n双尾怪手<br>\n\n肯泰罗<br>\n\n变隐龙<br>\n\n皮可西<br>\n\n大尾狸\n\n就是这样。<br>\n\n我要靠这套阵容夺得天下！等着我哦——もりもと先生！\n\n3天后……\n\n<figure class=\"gf-legacy-image\"><a href=\"/assets/images/gamefreak-legacy/staff/99/iwa081201_02-8534bdb4.jpg\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-legacy/staff/99/iwa081201_02-8534bdb4.jpg\" alt=\"負け負け\" loading=\"lazy\"></a></figure>\n\n虽然猫鼬斩努力奋战了，可惜还是没能晋级决胜淘汰赛……。<br>\n\n大家都好强……。\n\n我虽然遗憾地止步于联盟赛，但从激战中胜出的6人将在决胜淘汰赛中一决胜负。<br>\n\n所以，下一回我会为大家带来决胜淘汰赛的情况。\n\n敬请期待！\n\n<br>\n</div>\n\n<div data-gf-language-panel=\"ja\" hidden>\nこんにちは。<br>\n\nプランナーのいわしです。\n\n突然ですが、皆さんはポケモンを遊ぶとき、どこで一番アツくなりますか？<br>\n\n図鑑の収集でしょうか？<br>\n\nコンテストでしょうか？<br>\n\nはたまた、ストーリー展開でしょうか？<br>\n\nボックスをピッピやゴクリンで埋め尽くすとか？？<br>\n\nたくさんの遊び方のあるポケモンですが、いわしは断然バトルです！\n\nポケモンバトルは来年から世界大会が行われ、現在も各国の代表を決める<br>\n\n予選大会が日本各地、世界各地で行われているのです！\n\n実はゲームフリーク社内におきましても、ポケットモンスタープラチナの<br>\n\n発売記念と称しましてバトル大会が開かれました！<br>\n\n[前にカニ子のにっき](http://www.gamefreak.co.jp/blog/staff/?p=95)でも触れられていましたね。\n\n<figure class=\"gf-legacy-image\"><a href=\"/assets/images/gamefreak-legacy/staff/99/iwa081201_01-daead84b.jpg\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-legacy/staff/99/iwa081201_01-daead84b.jpg\" alt=\"みんな対戦中\" loading=\"lazy\"></a></figure>\n\n過去にもゲームフリークでは、新作を出すたびに社内でバトル大会を<br>\n\nおこなってきました。<br>\n\n今回は世界大会の公式ルールに則ってのダブルバトルです！<br>\n\nシングルとは一味違ったポケモン育成や戦術が必要になってくるんですよ〜。\n\n↓世界大会や公式ルールの情報はこちら↓<br>\n\n[http://www.pokemon.co.jp/special/wcs0809/](http://www.pokemon.co.jp/special/wcs0809/)\n\nいわしにとっての見所はやはり、これまで幾度となく猛者たちが挑んでは<br>\n\n返り討ちに遭ってきた社内最強のポケモントレーナー、もりもとの<br>\n\n手に土を付けるトレーナーが現れかですね〜。<br>\n\nむしろ付けにいく！という意気込みで、今回いわしもバトル大会に参加しました！\n\n今回の大会は総勢26名の社員が参加する大規模な大会となっております。<br>\n\nスタッフブログでおなじみのカニ子やカビなども参加していますよ！<br>\n\n大人数になりましたので、参加者を２つのリーグに分けて総当り戦を行い<br>\n\n勝ち数の多い順に上位3名が決勝トーナメントに進出するということになりました。\n\nちなみにいわしのメンバー編成は…\n\nザングース<br>\n\nエテボース<br>\n\nケンタロス<br>\n\nカクレオン<br>\n\nピクシー<br>\n\nビーダル\n\nです。<br>\n\nいわしはこれで天下を取ります！待ってろよー、もりもとさーん！\n\n３日後…\n\n<figure class=\"gf-legacy-image\"><a href=\"/assets/images/gamefreak-legacy/staff/99/iwa081201_02-8534bdb4.jpg\" target=\"_blank\" rel=\"noopener\"><img src=\"/assets/images/gamefreak-legacy/staff/99/iwa081201_02-8534bdb4.jpg\" alt=\"負け負け\" loading=\"lazy\"></a></figure>\n\nザングースが頑張ってくれたのですが、惜しくも決勝トーナメント出場ならず…。<br>\n\nみんな強い…。\n\n僕は惜しくもリーグ戦敗退でしたが、接戦を制した６人が決勝トーナメントで戦います。<br>\n\nということで、次回は決勝トーナメントの様子をお伝えしますね。\n\n乞うご期待！\n\n<br>\n</div>","markdown_ja":null}}